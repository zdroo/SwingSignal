{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost\\SQLEXPRESS;Database=RegimeDeck;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Features": {
    "ProEnabled": false
  },
  "Jwt": {
    "Issuer": "RegimeDeck",
    "Audience": "RegimeDeckWeb"
  },
  "Resend": {
    "From": "RegimeDeck <onboarding@resend.dev>"
  },
  "Stripe": {
    "MonthlyPriceId": "",
    "YearlyPriceId": ""
  },
  "_secrets_comment": "Fred:ApiKey, Jwt:Secret, Google:ClientId, Resend:ApiKey, Resend:DevRedirectTo, Stripe:SecretKey, Stripe:WebhookSecret live in user-secrets (dev) or environment variables (production). Stripe:MonthlyPriceId/YearlyPriceId are non-secret price ids. Run: dotnet user-secrets list"
}
