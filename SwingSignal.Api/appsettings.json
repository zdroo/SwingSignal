{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=SwingSignal;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Frontend": {
    "Url": "http://localhost:3000"
  },
  "Jwt": {
    "Issuer": "SwingSignal",
    "Audience": "SwingSignalWeb"
  },
  "Resend": {
    "From": "SwingSignal <onboarding@resend.dev>"
  },
  "_secrets_comment": "Fred:ApiKey, Jwt:Secret, Google:ClientId, Resend:ApiKey, Resend:DevRedirectTo live in user-secrets (dev) or environment variables (production). Run: dotnet user-secrets list"
}
