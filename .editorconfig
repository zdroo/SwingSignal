# Root editorconfig for the SwingSignal backend — codifies the existing style.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,slnx}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# var everywhere (the codebase convention)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression bodies where they read well
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_constructors = when_on_single_line:suggestion

# Pattern matching and modern C#
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
dotnet_style_prefer_collection_expression = true:suggestion

# Braces optional for single statements (existing convention)
csharp_prefer_braces = when_multiline:suggestion

# ── Analyzer tuning ────────────────────────────────────────────────────
# Logging perf micro-optimizations (LoggerMessage delegates, lazy argument
# evaluation): not worth the ceremony at this call volume
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# Generated EF migrations are exempt from analysis
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Test naming follows the xUnit Method_Scenario_Expectation convention;
# inline expected-value arrays in asserts are clearer than hoisted fields
[SwingSignal.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
